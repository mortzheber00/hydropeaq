?xml version="1.0"?>
<sdf version="1.6">
  <world name="fluid_world">

    <!-- Load the SPlisHSPlasH coupling plugin -->
    <plugin name="gazebo_fluids" filename="libGazeboFluidsPlugin.so">
      <scene_file>$(find amph)/stage2_gait_validation/scenes/water_tank.json</scene_file>
      <time_step>0.001</time_step>         <!-- SPH timestep [s] -->
      <gravity>0 0 -9.81</gravity>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Spawn the robot -->
    <include>
      <uri>model://amph</uri>
      <pose>0 0 0.05 0 0 0</pose>         <!-- start just at surface -->
    </include>

  </world>
</sdf>
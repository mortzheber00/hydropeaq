  <!-- Before trajectory_replay, and it has to stay there.  With no position
       controller spawned, joint_position_command_ is never written and stays
       at its initial 0.0, so DefaultRobotHWSim::writeSim still calls
       SetPosition(0, 0.0) on all 24 joints every step.  Both plugins write on
       WorldUpdateBegin and Gazebo fires handlers in connection order, so the
       later <gazebo> block wins: replay overwrites that 0.0 within the same
       step, before physics integrates.  Swap the two and the legs collapse to
       the zero pose.  The brake is set once at init and is unaffected. -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/BODY2</robotNamespace>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="trajectory_replay" filename="libtrajectory_replay_plugin.so">
      <topic>/BODY2/joint_trajectory_replay</topic>
    </plugin>
  </gazebo>
</robot>